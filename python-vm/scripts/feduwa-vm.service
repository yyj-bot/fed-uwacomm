[Unit]
Description=FedUWA Python VM Service
Documentation=https://github.com/your-org/fed-uwacomm
After=network.target
Wants=network-online.target

[Service]
Type=forking
User=feduwa
Group=feduwa
WorkingDirectory=/opt/feduwa/python-vm
ExecStart=/opt/feduwa/python-vm/scripts/start_vm.py start --daemon
ExecStop=/opt/feduwa/python-vm/scripts/start_vm.py stop
ExecReload=/bin/kill -HUP $MAINPID
PIDFile=/var/run/feduwa-vm.pid
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=feduwa-vm

# 环境变量
Environment=FEDUWA_ENV=prod
Environment=PYTHONPATH=/opt/feduwa/python-vm/src
Environment=FEDUWA_CONFIG_DIR=/etc/feduwa

# 安全设置
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/feduwa /var/run /tmp
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
