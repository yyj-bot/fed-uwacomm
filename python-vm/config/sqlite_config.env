# SQLite Database Configuration
# Path to the SQLite database file (relative to the working directory)
DB_PATH=data/bellhop_data.db

# Table name for features
DB_TABLE=features

# Optional: Set logging level
LOG_LEVEL=INFO

# Note: SQLite doesn't require host, port, user, or password
# The following MySQL settings are no longer needed:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=bellhop_data
